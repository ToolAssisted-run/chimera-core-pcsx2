 	}
 	DEV_LOG("Mechacon version: 0x{:08X}", s_mecha_version);
 }
 
+#ifdef CHIMERA_NVRAM_IN_MEMORY
+// chimera: the console's own memory, handed to the frontend.
+//
+// The NVRAM already IS a buffer - the machine reads and writes s_nvram, and
+// upstream only touches a file to remember it between runs. A sandboxed core
+// cannot write that file and should not: what a machine persists belongs to
+// the project, so it leaves through Chimera's save-data channel like a memory
+// card does, and arrives back mounted under the same name.
+//
+// This is what the console keeps when it is switched off: the language, the
+// clock configuration, the region parameters and the machine's iLink id.
+const u8* cdvdGetNVRAM(size_t* size)
+{
+	*size = NVRAM_SIZE;
+	return s_nvram;
+}
+
+void cdvdSaveNVRAM()
+{
+	// nothing to do: the frontend takes it through the save-data channel
+}
+#else
 void cdvdSaveNVRAM()
 {
 	Error error;

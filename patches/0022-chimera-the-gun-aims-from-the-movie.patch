 #include <tuple>
 
+#ifdef CHIMERA_WATERBOX
+// WHERE THE GUN IS POINTING COMES FROM THE MOVIE.
+//
+// Upstream asks InputManager for the position of the host's POINTER - the
+// mouse, on the desk, right now - and then converts it out of the emulator
+// window's coordinates into the display's. Neither half exists here, and the
+// first is worse than absent: a machine that aims itself from a mouse is a
+// machine no movie can replay, because the mouse is not in the movie.
+//
+// So the aim is an input like every other one. The package declares two
+// absolute axes per port (waterbox/waterbox.config's "Gun X" and "Gun Y"), a
+// movie carries them frame by frame like a stick, and the core hands them over
+// here already in the coordinates the window conversion would have produced:
+// 0..1 across the picture, and anything negative meaning the gun is not pointed
+// at the screen at all. waterbox/cinterface.cpp is the other end of this.
+//
+// It is the only reason this file is patched.
+extern "C" void chimera_guncon2_aim(unsigned port, float* x, float* y);
+#endif
+
+#ifdef CHIMERA_LAG_DETECTION
+// ...and the second: a LAG FRAME is a frame the machine never looked at its
+// input, and a machine holding a light gun does not look at a pad. Where it
+// looks is here - the interrupt endpoint the gun answers with its position and
+// its buttons - so that is where the frame is marked as seen.
+extern "C" void chimera_input_was_read(void);
+#endif
+
 namespace usb_lightgun

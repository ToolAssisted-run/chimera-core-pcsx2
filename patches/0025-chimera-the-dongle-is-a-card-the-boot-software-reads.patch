+#ifdef CHIMERA_ARCADE
+	/* chimera: the NAMCO board's dongle is a memory card, and the boot
+	 * software opens files on it (mc0:ACCORE and the rest) as the first thing
+	 * it does. The DAEMON module starts a security thread at priority 126
+	 * while that is happening, and it races mcman for mcman_io_sema: the card
+	 * opens come back fd=-6 and the board resets to its bios browser, which is
+	 * exactly what this core did on its first boot of Tekken 4. Real hardware
+	 * does not show it - the IOP schedules at a different granularity - so
+	 * this is an accuracy shortfall being worked around at the only place it
+	 * is visible, and it should go when the IOP's scheduling is closer.
+	 *
+	 * Taken from PS2Homebrew-arcade/pcsx2x6, where it is a JVS option; here it
+	 * is unconditional on an arcade machine and absent on a PlayStation 2,
+	 * because a console has no dongle to race for. */
+	namespace thbase
+	{
+		static bool s_suppress_next_start = false;
+
+		int CreateThread_HLE()
+		{
+			if (chimera_arcade_present && iopMemRead32(a0 + 16) >= 126)
+				s_suppress_next_start = true;
+			return 0;
+		}
+
+		int StartThread_HLE()
+		{
+			if (s_suppress_next_start)
+			{
+				s_suppress_next_start = false;
+				v0 = 0;
+				pc = ra;
+				return 1;
+			}
+			return 0;
+		}
+	} // namespace thbase
+#endif

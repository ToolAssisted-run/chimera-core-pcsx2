-static const u32 PS2CLK = 294912000;	//Hz	/* 294.912 MHz */
-extern u32 PSXCLK;	/* 36.864 MHz */
+// chimera: the EE bus clock is the MACHINE's rather than a constant. A
+// PlayStation 2 and a System 246 run at 294.912 MHz; a System 256 runs a third
+// faster and a Super 256 a half faster, which is the whole difference between
+// those two boards. Nothing else changes: every user of PS2CLK reads it the
+// same way, and a console project is set to the same number the constant was.
+static const u32 PS2CLK_DEFAULT = 294912000;	//Hz	/* 294.912 MHz - PS2 and System 246 */
+static const u32 PS2CLK_S256    = 393216000;	//Hz	/* 393.216 MHz - System 256 (x4/3) */
+static const u32 PS2CLK_SS256   = 442368000;	//Hz	/* 442.368 MHz - Super System 256 (x3/2) */
+extern u32 PS2CLK;
+extern u32 PSXCLK;	/* 36.864 MHz on a PS2; the EE clock over eight */
 
 

diff --git a/common/emitter/x86types.h b/common/emitter/x86types.h
index 559fb20..6b30e06 100644
--- a/common/emitter/x86types.h
+++ b/common/emitter/x86types.h
@@ -17,8 +17,20 @@ enum XMMSSEType
 	//XMMT_FPD = 3, // double
 };
 
-extern thread_local u8* x86Ptr;
-extern thread_local XMMSSEType g_xmmtypes[iREGCNT_XMM];
+// chimera: a sandbox has ONE thread, and its whole state must be visible to
+// the frontend's savestate. Thread-local storage is neither: it lives in a
+// per-thread block the guest's state does not describe, and the guest
+// toolchain refuses it outright for that reason. The emitter's cursor and
+// register table are per-thread upstream because two recompiler threads may
+// generate code at once; here there is one, so they are ordinary globals.
+#ifdef CHIMERA_NO_THREAD_LOCAL
+#define CHIMERA_THREAD_LOCAL
+#else
+#define CHIMERA_THREAD_LOCAL thread_local
+#endif
+
+extern CHIMERA_THREAD_LOCAL u8* x86Ptr;
+extern CHIMERA_THREAD_LOCAL XMMSSEType g_xmmtypes[iREGCNT_XMM];
 
 namespace x86Emitter
 {

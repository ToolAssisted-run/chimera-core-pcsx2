+//****************************************************************
+// Full mode (eeClampMode 3): the same sums as the recompiler's
+// double-precision FPU (x86/iFPUd.cpp), so games that need it compute
+// the same values when interpreted.
+//****************************************************************
+
+// Exponent 0 is zero, and exponent 255 is an ordinary number: the PS2
+// has no infinities or NaNs.
+static double fpuFullToDouble(u32 f)
+{
+	if ((f & 0x7f800000) == 0)
+		return (f & 0x80000000) ? -0.0 : 0.0;
+	if ((f & 0x7f800000) == 0x7f800000)
+		return static_cast<double>(std::bit_cast<float>(f - 0x00800000)) * 2.0;
+	return static_cast<double>(std::bit_cast<float>(f));
+}
+
+// ToPS2FPU_Full: rounds by the current FPCR, keeps results in the PS2's
+// range, and flushes underflows (an add/sub keeps its mantissa bits).
+static u32 fpuFullToPS2(double d, bool flags, bool acc, bool addsub)
+{
+	if (flags)
+		clearFPUFlags(FPUflagO | FPUflagU);
+	if (flags && acc)
+		fpuRegs.ACCflag &= ~1;
+
+	const u64 bits = std::bit_cast<u64>(d);
+	const u32 sign = static_cast<u32>(bits >> 32) & 0x80000000;
+	const double ad = std::fabs(d);
+
+	if (ad >= 0x1p129)
+	{
+		if (flags)
+		{
+			_ContVal_ |= FPUflagO | FPUflagSO;
+			if (acc)
+				fpuRegs.ACCflag |= 1;
+		}
+		return sign | 0x7fffffff;
+	}
+	if (ad >= 0x1p128)
+		return std::bit_cast<u32>(static_cast<float>(d * 0.5)) + 0x00800000;
+	if (ad < 0x1p-126)
+	{
+		if (flags && ad != 0.0)
+		{
+			_ContVal_ |= FPUflagU | FPUflagSU;
+			if (addsub)
+				return sign | static_cast<u32>((bits << 12) >> 41);
+		}
+		return sign;
+	}
+	return std::bit_cast<u32>(static_cast<float>(d));
+}
+
+// FPU_ADD_SUB: the EE adds without guard bits, so the bits of the smaller
+// operand that would be shifted out are dropped first.
+static void fpuFullAddSubMask(u32& d, u32& t)
+{
+	const int diff = static_cast<int>((d >> 23) & 0xff) - static_cast<int>((t >> 23) & 0xff);
+	if (diff >= 25)
+		t &= 0x80000000;
+	else if (diff > 0)
+		t &= 0xffffffffu << (diff - 1);
+	else if (diff <= -25)
+		d &= 0x80000000;
+	else if (diff < 0)
+		d &= 0xffffffffu << (-diff - 1);
+}
+
+static u32 fpuFullAddSub(u32 s, u32 t, bool sub, bool acc)
+{
+	fpuFullAddSubMask(s, t);
+	const double a = fpuFullToDouble(s), b = fpuFullToDouble(t);
+	return fpuFullToPS2(sub ? a - b : a + b, true, acc, true);
+}
+
+static u32 fpuFullMul(u32 s, u32 t, bool acc)
+{
+	if (CHECK_FPUMULHACK && s == 0x3e800000 && t == 0x40490fdb)
+		return 0x3f490fda;
+	return fpuFullToPS2(fpuFullToDouble(s) * fpuFullToDouble(t), true, acc, false);
+}
+
+// recMaddsub: an overflowed product or accumulator propagates as +/-max.
+static u32 fpuFullMaddSub(u32 s, u32 t, bool sub, bool acc)
+{
+	u32 prod = fpuFullMul(s, t, false);
+	u32 a = _FAValUl_;
+	fpuFullAddSubMask(a, prod);
+
+	u32 r;
+	if (_ContVal_ & FPUflagO)
+		r = sub ? (prod ^ 0x80000000) : prod;
+	else if (fpuRegs.ACCflag & 1)
+		r = a;
+	else
+	{
+		const double x = fpuFullToDouble(a), y = fpuFullToDouble(prod);
+		return fpuFullToPS2(sub ? x - y : x + y, true, acc, true);
+	}
+
+	clearFPUFlags(FPUflagO | FPUflagU);
+	_ContVal_ |= FPUflagO | FPUflagSO;
+	if (acc)
+		fpuRegs.ACCflag |= 1;
+	return r | 0x7fffffff;
+}
+
+static FPControlRegister fpuFullNearest()
+{
+	FPControlRegister fpcr = EmuConfig.Cpu.FPUFPCR;
+	fpcr.SetRoundMode(FPRoundMode::Nearest);
+	return fpcr;
+}
+
+#define C_cond_S_Full(cond) {  \
+	_ContVal_ = ( fpuFullToDouble(_FsValUl_) cond fpuFullToDouble(_FtValUl_) ) ?  \
+				( _ContVal_ | FPUflagC ) :  \
+				( _ContVal_ & ~FPUflagC );  \
+}

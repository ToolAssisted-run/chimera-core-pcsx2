+#ifdef CHIMERA_NO_GS_THREAD
+/* chimera: no GS thread.
+ *
+ * A sandbox has one thread, and a movie could not depend on how two of them
+ * interleaved anyway. MTGS is a ring buffer with one producer and one
+ * consumer, so the consumer runs where the producer stands: the EE submits a
+ * packet and the GS processes it there and then (ProcessRingBuffer above).
+ *
+ * These five entry points are all that separates the two arrangements. The
+ * ring buffer, the packet formats and the GS itself are untouched.
+ */
+void MTGS::PumpInline()
+{
+	if (!s_open_flag.load(std::memory_order_acquire))
+		return;
+
+	std::unique_lock mtvu_lock(s_mtx_RingBufferBusy2);
+	ProcessRingBuffer(mtvu_lock);
+}
+
+void MTGS::StartThread()
+{
+	if (s_open_flag.load(std::memory_order_acquire))
+		return;
+
+	std::memcpy(RingBuffer.Regs, PS2MEM_GS, sizeof(PS2MEM_GS));
+	const bool opened = GSopen(EmuConfig.GS, EmuConfig.GS.Renderer, RingBuffer.Regs,
+		VMManager::GetEffectiveVSyncMode(), VMManager::ShouldAllowPresentThrottle());
+	s_open_flag.store(opened, std::memory_order_release);
+	s_shutdown_flag.store(false, std::memory_order_release);
+}
+
+void MTGS::ShutdownThread()
+{
+	if (!s_open_flag.load(std::memory_order_acquire))
+		return;
+
+	PumpInline();
+	s_open_flag.store(false, std::memory_order_release);
+	s_shutdown_flag.store(true, std::memory_order_release);
+	GSclose();
+}
+#else
 void MTGS::StartThread()
 {
 	if (s_thread.Joinable())

+#ifdef CHIMERA_EMBEDDED_GAMEDB
+/* chimera: a core has no resources directory. Its file system is whatever the
+ * project mounted, and nobody mounts an emulator's per-title database - so the
+ * read below always failed, and every PS2 game ran with an EMPTY database and
+ * none of its own fixes. The database is compiled in instead; see
+ * waterbox/gen-gamedb.py for what it carries and waterbox/game-database.cpp for
+ * how it is read. It is also then part of the core's identity, pinned by the
+ * package a movie cites, rather than a file that can change underneath one. */
+void ChimeraInitGameDB(std::unordered_map<std::string, GameDatabaseSchema::GameEntry>& db);
+
+void GameDatabase::initDatabase()
+{
+	ChimeraInitGameDB(s_game_db);
+}

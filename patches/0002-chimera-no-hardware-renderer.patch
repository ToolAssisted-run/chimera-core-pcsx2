 static int s_shm_fd = -1;
 
+#ifdef CHIMERA_NO_SHARED_MEMORY
+// chimera: the GS's four megabytes, allocated plainly.
+//
+// Upstream maps the same shared pages FOUR TIMES in a row, so that address
+// arithmetic which runs off the end of video memory lands back at the start
+// instead of faulting. A sandbox has no shared memory and cannot map anything
+// twice, so the four copies are four real megabytes each.
+//
+// The difference is visible only to a program that reads or writes PAST the
+// end of the GS's memory: upstream wraps, this reads the copy. Nothing does
+// that on purpose - it is a safety net for swizzle arithmetic - and a movie
+// that depended on it would be depending on an aliasing trick rather than on
+// the console. If a game is ever found that needs it, the answer is to make
+// the copies aliases in the sandbox, not to reserve address space here.
+void* GSAllocateWrappedMemory(size_t size, size_t repeat)
+{
+	void* mem = std::aligned_alloc(__pagesize, size * repeat);
+	if (mem)
+		std::memset(mem, 0, size * repeat);
+	return mem;
+}
+
+void GSFreeWrappedMemory(void* ptr, size_t size, size_t repeat)
+{
+	std::free(ptr);
+}
+#else
 void* GSAllocateWrappedMemory(size_t size, size_t repeat)

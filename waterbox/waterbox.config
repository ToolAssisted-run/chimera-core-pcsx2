    {
      "id": "bios.bin",
      "display": "PlayStation 2 BIOS",
      "description": "The console's own BIOS, copied from a PlayStation 2 you own. This project asks for Japan v1.20 (2000-10-27) build 185015. The file is usually called ps2-0120j-20001027-185015.bin. Another copy of the same version is accepted. A different version is a different machine, and you choose it with the Boot ROM setting.",
      "size": 4194304,
      "name": "ps2-0120j-20001027-185015.bin",
      "sha1": "E481079ECA752225555F0C26D14C9D0F94D9A8E9",
      "label": "Japan v1.20 (2000-10-27) build 185015",

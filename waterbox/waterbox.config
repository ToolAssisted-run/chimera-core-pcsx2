    {
      "id": "bios.bin",
      "display": "NAMCO System 246/256 BIOS",
      "description": "The arcade board's own boot rom, dumped from a COH-H motherboard. This is NOT a retail PlayStation 2 bios and a retail dump will not do: the arcade boot software differs across a plethora of module interfaces and an arcade game will not start on it. A COH-H rom names itself in its ROMVER - zone T with a Z after it - and the board it came from in its EXTINFO build serial, which is the only thing that tells the three boards apart. This project asks for the System 246 Rack C rom, serial 20021119-163841, 2 MB. Redump calls the dump ps2-arcade-0100tz-20021119-163841.bin; MAME carries the same bytes as r27v1602f.7d in its sys246 bios set, and it also circulates as 246C.bin.",
      "size": 2097152,
      "name": "ps2-arcade-0100tz-20021119-163841.bin",
      "sha1": "F0A74BBCAF801F3FD0B7002EBD0118564AAE3528",
      "label": "System 246 Rack C (serial 20021119-163841)",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "in": [
              "system246",
              "system256",
              "system256super"
            ]
          },
          {
            "setting": "bios",
            "is": "coh-h-246c"
          }
        ]
      }
    },
    {
      "id": "bios.bin",
      "display": "NAMCO System 246/256 BIOS",
      "description": "The arcade board's own boot rom, dumped from a COH-H motherboard. This is NOT a retail PlayStation 2 bios and a retail dump will not do: the arcade boot software differs across a plethora of module interfaces and an arcade game will not start on it. A COH-H rom names itself in its ROMVER - zone T with a Z after it - and the board it came from in its EXTINFO build serial, which is the only thing that tells the three boards apart. This project asks for the System 256 rom, serial 20040519-145634, 2 MB. Redump calls the dump ps2-arcade-0100tz-20040519-145634.bin and MAME carries the same bytes as r27v1602f.8g in its sys256 bios set. A Super System 256 runs this same rom with the bus overclocked, which is why both machines ask for it.",
      "size": 2097152,
      "name": "ps2-arcade-0100tz-20040519-145634.bin",
      "sha1": "BC4FB4E1E53ADBD92385F1726BD69663FF870F1E",
      "label": "System 256 (serial 20040519-145634)",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "in": [
              "system246",
              "system256",
              "system256super"
            ]
          },
          {
            "setting": "bios",
            "is": "coh-h-256"
          }
        ]
      }
    },
    {
      "id": "bios.bin",
      "display": "NAMCO System 246/256 BIOS",
      "description": "The arcade board's own boot rom, dumped from a COH-H motherboard. This is NOT a retail PlayStation 2 bios and a retail dump will not do: the arcade boot software differs across a plethora of module interfaces and an arcade game will not start on it. A COH-H rom names itself in its ROMVER - zone T with a Z after it - and the board it came from in its EXTINFO build serial, which is the only thing that tells the three boards apart. This project asks for the System 256 rom as a 4 MB dump with its two megabytes written twice over - what a dumper that read the whole window produces, and a dump in wide circulation under the name 256.BIN. The machine it describes is the same System 256 as the 2 MB dump above; the bytes are not, and this core pins firmware by hash.",
      "size": 4194304,
      "name": "256.BIN",
      "sha1": "B0BDC34D953D93D3D154BC34FD854C635A8C5FEE",
      "label": "System 256, 4 MB mirrored dump",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "in": [
              "system246",
              "system256",
              "system256super"
            ]
          },
          {
            "setting": "bios",
            "is": "coh-h-256-mirrored"
          }
        ]
      }
    },
    {
      "id": "bios.bin",
      "display": "NAMCO System 246/256 BIOS",
      "description": "The arcade board's own boot rom, dumped from a COH-H motherboard. This is NOT a retail PlayStation 2 bios and a retail dump will not do: the arcade boot software differs across a plethora of module interfaces and an arcade game will not start on it. A COH-H rom names itself in its ROMVER - zone T with a Z after it - and the board it came from in its EXTINFO build serial, which is the only thing that tells the three boards apart. This project asks for the COH-H A-000-010 board's rom, serial 20000901-114731, 4 MB, usually called COH-H31000.BIN. That is the earliest of the three and the one the arcade development boards carried.",
      "size": 4194304,
      "name": "COH-H31000.BIN",
      "sha1": "9A67E2D344B1132A183881C267463078B220ED21",
      "label": "COH-H A-000-010 board (serial 20000901-114731)",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "in": [
              "system246",
              "system256",
              "system256super"
            ]
          },
          {
            "setting": "bios",
            "is": "coh-h-a000010"
          }
        ]
      }
    }
  ]
}

      }
    },
    {
      "name": "fast_boot",
      "display": "Skip the Console Boot",
      "type": "bool",
      "default": true,
      "description": "Boot the disc's own program directly instead of watching the console start up. The bios animation is about twenty seconds of emulated time and the machine is in a different state at the end of it, so this is part of what a movie was recorded on rather than a convenience: a run made with it does not replay without it.",
      "exposedWhen": {
        "setting": "machine",
        "is": "ps2"
      }
    },
    {
      "name": "rtc_year",
      "display": "Clock: Year (00-99)",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 99,
      "description": "What year the console's clock says. A PS2 has a battery-backed clock and PCSX2 would otherwise read the computer's, which makes every run a different machine - some games seed their random numbers from it, and every save is stamped with it. The default is 2020: late enough that every PS2 game accepts it as today."
    },
    {
      "name": "rtc_month",
      "display": "Clock: Month",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 12,
      "description": "The month on the console's clock."
    },
    {
      "name": "rtc_day",
      "display": "Clock: Day",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 31,
      "description": "The day on the console's clock."
    },
    {
      "name": "rtc_hour",
      "display": "Clock: Hour",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 23,
      "description": "The hour on the console's clock."
    },
    {
      "name": "rtc_minute",
      "display": "Clock: Minute",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 59,
      "description": "The minute on the console's clock."
    },
    {
      "name": "rtc_second",
      "display": "Clock: Second",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 59,
      "description": "The second on the console's clock."
    },
    {
      "name": "verbose",
      "display": "Log the Machine",
      "type": "bool",
      "default": false,
      "description": "Let PCSX2 say what it is doing on the standard error stream: which bios and disc it found, what the IOP loaded, what it refused. It changes nothing about the machine - the clock this core runs on belongs to the emulated console, not to whoever is reading the log - and it is the first thing to turn on when a project will not start."
    },
    {
      "name": "cpu_core",
      "display": "CPU Cores",
      "description": "Which CPU implementations run the machine: PCSX2's recompilers (EE, IOP and both VUs translated to x86 as they run - the way upstream PCSX2 plays, several times faster) or its interpreters (the slowest, most literal reading of every instruction). They are DIFFERENT MACHINES - the recompiler's EE floating point is not the interpreter's - so the choice is pinned in the project and cited by the movie, and a movie made under one does not replay under the other.",
      "type": "enum",
      "options": [
        "recompiler",
        "interpreter"
      ],
      "default": "recompiler"
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl",
        "opengl-hw"
      ],
      "default": "software",
      "description": "Which renderer draws the picture. 'software' is PCSX2's own software rasteriser, and the default: it runs entirely inside the sandbox on the CPU, so the picture is the same on every machine that replays the movie and nothing about it depends on your driver. Two runs of 2401 frames of Gran Turismo 4 under it are byte-identical at frames 900, 1500 and 2400. 'opengl' is PCSX2's OpenGL renderer - the one upstream tests and most games are looked at through - drawing through a Mesa softpipe compiled into this core; it is inside the sandbox and deterministic too, and slower than the rasteriser beside it. 'opengl-hw' is that same OpenGL renderer with its calls leaving the sandbox to your machine's GPU. It is the fastest of the three where there is a GPU to take it - the same 2401 frames on a GTX 1060 cost 9.6s against the rasteriser's 20.6s - and it is NOT deterministic: the picture comes from a driver that is outside the sandbox and outside the savestate, and differs between machines. A movie recorded on it records that a GPU drew. It is not the default because it is the path that has gone wrong in use: a re-recorded run's picture could come back visibly wrong (ToolAssisted-run/chimera issues 55 and 56), and a build or a machine that cannot give it a GL context falls back to the softpipe, which on Windows dies after about a thousand frames. What no renderer changes is the machine: EE RAM after 2401 frames is identical under the rasteriser and under the GPU, so the choice is about the picture and the speed and never about the run."
    },
    {
      "name": "deinterlace",
      "display": "Deinterlacing",
      "type": "enum",
      "options": [
        "auto",
        "adaptive",
        "adaptive-bff",
        "weave",
        "weave-bff",
        "blend",
        "bob",
        "off"
      ],
      "default": "auto",
      "description": "How the console's two fields become one picture, when they are two fields at all. A PS2 in an interlaced mode scans out HALF an image per frame - 224 lines of 448, the other half arriving next frame - so something has to say what a single field looks like as a whole frame. But plenty of games draw WHOLE frames instead, and putting one of those through a deinterlacer destroys half of it: the picture then carries one row of this frame and one row of the last, forever. 'auto' asks the machine which it is doing, leaves a whole frame alone, and reconstructs a field one with 'adaptive' - which is what PCSX2 itself does and what this should be left on. The rest force one answer. 'adaptive' compares this field with the three before it and decides, per pixel, whether to weave a line or invent one from the lines above and below: still pictures keep their full detail and moving ones do not comb. 'weave' puts each field's lines back in their proper places, which is the full picture the television showed; fast motion combs, as it does on the real machine. 'weave-bff' and 'adaptive-bff' are the same with the field order swapped, for a game that looks one line out of place. 'blend' is weave with the comb softened. 'bob' shows the current field alone, scaled up: never combs, and half the vertical detail. 'off' hands the field over stretched and puts nothing anywhere, which makes a still screen climb two scanlines and fall back every frame."
    },
    {
      "name": "textureFiltering",
      "display": "Texture Filtering",
      "type": "enum",
      "options": [
        "machine",
        "nearest",
        "linear",
        "linearNoSprites"
      ],
      "default": "machine",
      "description": "How a texture is sampled when it does not land one texel to one pixel, under the OpenGL renderers only - the software rasteriser samples the way the GS does and ignores this. 'machine' is what the game asked the GS for, texture by texture, and is the picture the console drew. 'nearest' takes the nearest texel always. 'linear' blends always, which smooths a game that asked for nearest; 'linearNoSprites' does the same but leaves sprites alone, which keeps 2D text crisp. THIS ONE CAN AFFECT SYNC. It decides what the GPU puts in every render target, and PCSX2 writes a render target back into the console's memory whenever a game reads its own picture - so on such a game the bytes it reads depend on this value. Measured on Maximo and Gran Turismo 4 (up to 6000 frames) it changed the picture and not a byte of memory, but it is pinned by the project all the same, and a movie made with one value needs the same value to play back. Choose it when the project is created."
    },
    {
      "name": "fxaa",
      "display": "FXAA",
      "type": "bool",
      "default": false,
      "description": "PCSX2's own fast approximate anti-aliasing, a shader run over the finished picture after the console's display circuits have merged it - under the OpenGL renderers only; the software rasteriser draws into a device with no shader stage, so there it stays off whatever this says. Nothing reads the finished picture back, so this cannot change the machine: measured on Maximo, Gran Turismo 4 and Street Fighter EX3 it changed the picture and not a byte of memory, the audio or the lag count. It is a project setting because a value reaches a core only that way, and because it is what the movie's picture looked like; a movie made with it plays back without it and vice versa, at the cost of a restart, since changing any setting starts the core again."
    },
    {
      "name": "bios",
      "display": "Boot ROM",
      "type": "enum",
      "options": [
        "ps2-0100j-20000117",
        "ps2-0101j-20000217",
        "ps2-0110a-20000727",
        "ps2-0120a-20000902",
        "ps2-0120e-20000902",

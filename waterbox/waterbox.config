    {
      "name": "fast_boot",
      "display": "Skip the Console Boot",
      "type": "bool",
      "default": true,
      "description": "Starts the disc's own program directly, without the console's start-up sequence. The BIOS animation takes about twenty seconds of emulated time, and the machine is in a different state at the end of it. So this is part of what a movie was recorded on, and not only a convenience: a movie made with it does not play back without it.",
      "exposedWhen": {
        "setting": "machine",
        "is": "ps2"
      }
    },
    {
      "name": "rtc_year",
      "display": "Clock: Year (00-99)",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 99,
      "description": "The year on the console's clock. A PS2 has a clock with a battery. Without this setting PCSX2 would read your computer's clock, and then every run would be a different machine: some games take their random numbers from the clock, and every save is stamped with it. The default is 2020, which is late enough for every PS2 game to accept it as today's date."
    },
    {
      "name": "rtc_month",
      "display": "Clock: Month",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 12,
      "description": "The month on the console's clock."
    },
    {
      "name": "rtc_day",
      "display": "Clock: Day",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 31,
      "description": "The day on the console's clock."
    },
    {
      "name": "rtc_hour",
      "display": "Clock: Hour",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 23,
      "description": "The hour on the console's clock."
    },
    {
      "name": "rtc_minute",
      "display": "Clock: Minute",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 59,
      "description": "The minute on the console's clock."
    },
    {
      "name": "rtc_second",
      "display": "Clock: Second",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 59,
      "description": "The second on the console's clock."
    },
    {
      "name": "verbose",
      "display": "Log the Machine",
      "type": "bool",
      "default": false,
      "description": "Makes PCSX2 report what it is doing on the standard error output: which BIOS and disc it found, what the input/output processor (the IOP) loaded, and what it refused. It does not change the machine, because the clock this core runs on is the emulated console's and does not depend on who reads the log. It is the first thing to turn on when a project will not start."
    },
    {
      "name": "cpu_core",
      "display": "CPU Cores",
      "description": "Which processor implementations run the machine. The recompilers translate the code of the EE, the IOP and both VUs to x86 code as it runs. This is how PCSX2 itself normally plays, and it is several times faster. The interpreters execute every instruction one at a time, which is the slowest and most literal way. They are DIFFERENT MACHINES, because the recompiler's EE floating point does not give the same results as the interpreter's. So the project and the movie record the choice, and a movie made with one does not play back with the other.",
      "type": "enum",
      "options": [
        "recompiler",
        "interpreter"
      ],
      "default": "recompiler"
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl",
        "opengl-hw"
      ],
      "default": "software",
      "description": "Which renderer draws the picture. 'software' is PCSX2's own software renderer and the default. It runs completely inside the core on the processor, so the picture is the same on every computer that plays the movie and does not depend on your graphics driver. Two runs of 2401 frames of Gran Turismo 4 with it are identical byte for byte at frames 900, 1500 and 2400. 'opengl' is PCSX2's OpenGL renderer, the one PCSX2's developers test with and most games are checked with. Here it draws with an OpenGL that is built into the core (Mesa's softpipe). It also gives the same picture on every computer, and it is slower than the software renderer. 'opengl-hw' is the same OpenGL renderer drawing on your computer's graphics card. It is the fastest of the three where there is a graphics card: the same 2401 frames took 9.6 seconds on a GTX 1060, against 20.6 seconds with the software renderer. It does NOT give the same picture everywhere. The picture comes from a driver that is outside the core and outside the savestate, and it differs between computers. A movie recorded with it records that a graphics card drew the picture. It is not the default because it is the choice that has gone wrong in use. The picture of a run that was recorded again could come back visibly wrong (ToolAssisted-run/chimera issues 55 and 56). And when a build or a computer cannot give it OpenGL, it falls back to the softpipe, which on Windows crashes after about a thousand frames. No renderer changes the machine: the console's main memory after 2401 frames is identical with the software renderer and with the graphics card. So the choice is about the picture and the speed, and never about the run."
    },
    {
      "name": "deinterlace",
      "display": "Deinterlacing",
      "type": "enum",
      "options": [
        "auto",
        "adaptive",
        "adaptive-bff",
        "weave",
        "weave-bff",
        "blend",
        "bob",
        "off"
      ],
      "default": "auto",
      "description": "How the console's two fields become one picture, when the game produces fields at all. In an interlaced mode a PS2 sends out HALF a picture per frame: 224 lines of 448, with the other half in the next frame. Something has to decide what a single field looks like as a whole frame. But many games draw WHOLE frames instead, and running one of those through a deinterlacer destroys half of it: the picture then always has one row from this frame and one row from the previous frame. 'auto' asks the machine which of the two it is doing. It leaves a whole frame alone and rebuilds a field picture with 'adaptive'. This is what PCSX2 itself does, and it should normally be left on. The other choices force one method. 'adaptive' compares this field with the three before it and decides for each pixel whether to keep a line or to make one from the lines above and below. Still pictures keep their full detail, and moving ones show no comb pattern. 'weave' puts each field's lines back in their proper places. That is the full picture the television showed, and fast motion shows a comb pattern, as it does on the real machine. 'weave-bff' and 'adaptive-bff' are the same with the order of the fields swapped, for a game that looks one line out of place. 'blend' is weave with the comb pattern softened. 'bob' shows the current field alone, scaled up. It never shows a comb pattern, and it has half the vertical detail. 'off' hands over the field stretched and places nothing, which makes a still screen move up two lines and back down on every frame."
    },
    {
      "name": "textureFiltering",
      "display": "Texture Filtering",
      "type": "enum",
      "options": [
        "machine",
        "nearest",
        "linear",
        "linearNoSprites"
      ],
      "default": "machine",
      "description": "How a texture is sampled when one texture pixel does not land on exactly one screen pixel. It applies to the OpenGL renderers only. The software renderer samples the way the console's graphics chip (the GS) does and ignores this. 'machine' is what the game asked the GS for, texture by texture, and gives the picture the console drew. 'nearest' always takes the nearest texture pixel. 'linear' always blends, which smooths a game that asked for nearest. 'linearNoSprites' does the same but leaves sprites alone, which keeps 2D text sharp. THIS SETTING CAN AFFECT WHETHER A MOVIE PLAYS BACK. It decides what the graphics card puts into every surface it draws, and PCSX2 writes such a surface back into the console's memory whenever a game reads its own picture. For such a game, the bytes it reads depend on this value. When measured on Maximo and Gran Turismo 4 (up to 6000 frames) it changed the picture and not one byte of memory. The project records it all the same, and a movie made with one value needs the same value to play back. Choose it when the project is created."
    },
    {
      "name": "fxaa",
      "display": "FXAA",
      "type": "bool",
      "default": false,
      "description": "PCSX2's own fast approximate anti-aliasing (FXAA). It is a shader that runs over the finished picture, after the console's display circuits have combined it. It applies to the OpenGL renderers only. The software renderer has no shader stage, so there it stays off whatever is chosen here. Nothing reads the finished picture back, so this cannot change the machine. When measured on Maximo, Gran Turismo 4 and Street Fighter EX3 it changed the picture and not one byte of memory, the audio or the lag count. It is a project setting because that is the only way a value reaches a core, and because it is how the movie's picture looked. A movie made with it plays back without it, and the other way round. Changing it restarts the core, as changing any setting does."
    },
    {
      "name": "internalResolution",
      "display": "Internal Resolution",
      "type": "enum",
      "options": [
        "1x",
        "2x",
        "3x",
        "4x"
      ],
      "default": "1x",
      "description": "PCSX2's own upscaling. Every surface is drawn at this multiple of the console's size, so 3D looks sharper and a video can be made at a higher resolution. It applies to the OpenGL renderers only. The software renderer draws at the console's own size and ignores this. It works best with 'opengl-hw', because an OpenGL without a graphics card pays for every extra pixel on the processor. THIS SETTING CAN AFFECT WHETHER A MOVIE PLAYS BACK, in the same way as Texture Filtering. A game that reads its own picture back gets it through PCSX2's texture cache, which scales an upscaled surface back down, and the result is not always byte for byte the picture at the console's size. The project records it, and a movie made with one value needs the same value to play back. 2D games gain little, and some show seams at 2x and above, as they do in PCSX2."
    },
    {
      "name": "bios",
      "display": "Boot ROM",
      "type": "enum",
      "options": [
        "ps2-0100j-20000117",
        "ps2-0101j-20000217",
        "ps2-0110a-20000727",
        "ps2-0120a-20000902",
        "ps2-0120e-20000902",
        "ps2-0120j-20001027-185015",
        "ps2-0120j-20001027-191435",
        "ps2-0150a-20001228",
        "ps2-0150e-20001228",
        "ps2-0150j-20010118",
        "ps2-0160a-20010427",
        "ps2-0160a-20011004",
        "ps2-0160a-20020207",
        "ps2-0160e-20010704",
        "ps2-0160e-20011004",
        "ps2-0160e-20020319",
        "ps2-0160h-20010730",
        "ps2-0160h-20020426",
        "ps2-0160j-20010427",
        "ps2-0170a-20030325",
        "ps2-0170e-20030227",
        "ps2-0170j-20030206",
        "ps2-0190a-20030623",
        "ps2-0190c-20030623",
        "ps2-0190e-20030623",
        "ps2-0190h-20030623",
        "ps2-0190r-20030623",
        "ps2-0200a-20040614",
        "ps2-0200e-20040614",
        "ps2-0200h-20040614",
        "ps2-0200j-20040614",
        "ps2-0210j-20040917",
        "ps2-0220a-20050620",
        "ps2-0220a-20060210",
        "ps2-0220a-20060905",
        "ps2-0220e-20050620",
        "ps2-0220e-20060210",
        "ps2-0220e-20060905",
        "ps2-0220h-20060210",
        "ps2-0220h-20060905",
        "ps2-0230a-20080220",
        "ps2-0230e-20080220",
        "ps2-0101jd-20000217",
        "ps2-0101xd-20000224",
        "ps2-0110ad-20000727",
        "ps2-0120ed-20000902",
        "ps2-0150ad-20001228",
        "ps2-0150jd-20010118",
        "ps2-0170ad-20030325",
        "ps2-0170ed-20030227",
        "ps2-0180cd-20030224",
        "ps2-0180j-20031028",
        "ps2-0250j-20100415",
        "ps2-dvd-110u",
        "ps2-dvd-120e",
        "ps2-dvd-120u",
        "ps2-dvd-130e",
        "ps2-dvd-130u",
        "ps2-dvd-200j",
        "ps2-dvd-210e",
        "ps2-dvd-210j",
        "ps2-dvd-210u",
        "ps2-dvd-212g",
        "ps2-dvd-212u",
        "ps2-dvd-213e",
        "ps2-dvd-215g",
        "ps2-dvd-300e",
        "ps2-dvd-300u",
        "ps2-dvd-302c",
        "ps2-dvd-302e",
        "ps2-dvd-302u",
        "ps2-dvd-310",
        "ps2-dvd-311"
      ],
      "default": "ps2-0230a-20080220",
      "when": [
        "ps2"
      ],
      "description": "WHICH PlayStation 2 this project is. A PS2 cannot run a single instruction without its BIOS, and the emulator has no built-in replacement for it. The BIOS decides the console's region, its language, its menus, and what a game checks when it refuses to run. Each choice expects one exact file. The firmware page names the file and the SHA-1 it must have. Two projects with different BIOS versions are different machines and cannot share movies. The retail consoles are listed first. After them come the ROMs of the development kits (DEVKIT) and debug stations. Last comes the DVD PLAYER firmware, which is the ROM of the disc player and not a boot ROM, so a machine does not start from it.",
      "exposedWhen": {
        "setting": "machine",
        "is": "ps2"
      }
    },
    {
      "name": "bios",
      "display": "Boot ROM",
      "type": "enum",
      "options": [
        "coh-h-246c",
        "coh-h-256",
        "coh-h-256-mirrored",
        "coh-h-a000010"
      ],
      "default": "coh-h-246c",
      "when": [
        "system246",
        "system256",
        "system256super"
      ],
      "description": "WHICH arcade board this project is, in the only way the hardware can be told apart. Sony never changed the version or the date in a COH-H ROM: every one says v1.00 (2000-03-06). So the EXTINFO build serial inside the file is what tells them apart, and it names the board. 20021119-163841 is a System 246 Rack C. 20040519-145634 is a System 256 (the Super 256 runs the same ROM with a faster bus clock). 20000901-114731 is the COH-H A-000-010 development board. 'coh-h-256-mirrored' is the same System 256 ROM as a 4 MB file with its two megabytes written twice, which some copying tools produce. It is offered because that file is in circulation, and this core accepts firmware only by its exact hash. A RETAIL PlayStation 2 BIOS does not work and is not offered here. The arcade boot software differs in many module interfaces, and an arcade game does not run on a retail BIOS. The firmware page names the file and the SHA-1 it must have.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "arcade_game",
      "display": "Game ID",
      "type": "string",
      "default": "",
      "description": "NAMCO's part number for this game: \"NM\" and five digits, such as NM00004 for Tekken 4, NM00007 for Soul Calibur II and NM00019 for Tekken 5. It identifies the game the way a MAME set name does. The JVS board (the cabinet's input board) reads it to know how this cabinet's control panel was wired: which switch is which button, whether there is a wheel, a drum or a pair of levers, and where a light gun's sensor reports. A project that leaves it empty gets the board's general wiring. That starts and can be played, but it is not the cabinet the game was made for.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "arcade_media",
      "display": "Media",
      "type": "enum",
      "options": [
        "cd",
        "dvd",
        "hdd"
      ],
      "default": "dvd",
      "description": "The kind of medium the game was supplied on. It decides how the board's own disk controller (ATA/ATAPI) reads it. A COH-H board has no disc drive of its own, so the media is in the NAMCO board's drive and not in the console's tray. The exception is a CD game, which also asks the console for the disc, so this core puts it in both places. You choose the kind here, and it is not guessed. The PCSX2 version that this board support comes from looks it up in a game database, but a project states its own settings.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "arcade_ram",
      "display": "Board RAM",
      "type": "enum",
      "options": [
        "0",
        "32",
        "64",
        "128"
      ],
      "default": "64",
      "description": "How much memory the cabinet has on the NAMCO board, in megabytes. A System 246 Rack A takes expansion boards of 32 or 64 MB in two slots. Racks B and C have 64 MB built in. Wangan Midnight's cabinet has 128. A System 256 has none, and should be set to 0. It is a setting, and is not guessed from the game, for two reasons. The board's memory is part of every savestate this core makes, and 128 MB of it takes space. And a cabinet is something a person built, so a project has to be able to say what it has. A game that reads memory the cabinet does not have reads zeros, as it would from an empty expansion slot.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "arcade_panel",
      "display": "Panel",
      "type": "enum",
      "options": [
        "derived",
        "standard",
        "fighting",
        "lightgun",
        "racing",
        "drum",
        "twinstick",
        "touch"
      ],
      "default": "derived",
      "description": "How the cabinet's JVS input wiring is laid out. 'derived' takes it from the Game ID. That is right for every game the board knows, and a project should normally leave it there. The other choices force a layout, for a game that is not in the table or a cabinet that somebody converted. The choice decides which of the Arcade Panel's controls the board actually reads. A fighting cabinet reads six switches and no analog controls, a racing cabinet reads the wheel and the pedals, and a Taiko cabinet reads eight drum sensors. It is part of the machine, so a movie records it. The panel's controls are named after the WIRING and not after any game. 'P1 Button 1' is the first switch on player one's panel, and what it does depends on the game: a punch in one game, a gear change in another. Every control has a default key, so a cabinet can be played as soon as it starts, and you find out what each control does by playing the game. Nothing here is set up for a particular game.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "arcade_region",
      "display": "iLink Signature",
      "type": "enum",
      "options": [
        "none",
        "asia4",
        "asia5",
        "japan"
      ],
      "default": "none",
      "description": "The regional signature that a System 256 reads from the board's own iLink id. The Taiko Drum Master games use it to decide which region they are in. 'none' leaves the id that the machine's BIOS has. It does nothing on a System 246.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "dip_test",
      "display": "DIP 1: Test Mode",
      "type": "bool",
      "default": false,
      "description": "The test switch of the input/output board, as on the real board. It is a DIP SWITCH, which is why it is a setting and not a column in the movie. (The cabinet's TEST BUTTON is a separate control, Test in the Arcade Panel, and the board reports the two in one bit.) When the switch is on, the cabinet starts into its own test menu and not into the game. The coin settings, the input test and the game's own options are there. The position of the switch is part of the machine a movie was recorded on.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "dip_video_voltage",
      "display": "DIP 2: Video Voltage",
      "type": "bool",
      "default": true,
      "description": "The second of the input/output board's four DIP switches. It is reported to the game as part of the board's status. Like the other three it is part of the machine, so a movie records it. The default is the position a cabinet has when it leaves the factory.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "dip_monitor_sync",
      "display": "DIP 3: Monitor Sync Frequency",
      "type": "bool",
      "default": true,
      "description": "The third DIP switch. It says which sync frequency the cabinet's monitor uses, 15 kHz or 31 kHz. It is reported to the game, and some games read it to choose a video mode.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    },
    {
      "name": "dip_video_sync_split",
      "display": "DIP 4: Video Sync Split",
      "type": "bool",
      "default": true,
      "description": "The fourth DIP switch. It says whether the cabinet's monitor takes composite sync or separate horizontal and vertical sync. It is reported to the game as part of the same status.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "system246",
          "system256",
          "system256super"
        ]
      }
    }
  ],
  "firmware": [
    {
      "id": "bios.bin",
      "display": "PlayStation 2 BIOS",
      "description": "The console's own BIOS, copied from a PlayStation 2 you own. This project asks for Japan v1.00 (2000-01-17). The file is usually called ps2-0100j-20000117.bin. Another copy of the same version is accepted. A different version is a different machine, and you choose it with the Boot ROM setting.",
      "size": 4194304,
      "name": "ps2-0100j-20000117.bin",
      "sha1": "AEA061E6E263FDCC1C4FDBD68553EF78DAE74263",
      "label": "Japan v1.00 (2000-01-17)",
      "requiredWhen": {
        "setting": "bios",
        "is": "ps2-0100j-20000117"
      }
    },
    {
      "id": "bios.bin",
      "display": "PlayStation 2 BIOS",

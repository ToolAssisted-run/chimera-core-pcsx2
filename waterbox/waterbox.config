  "settings": [
    {
      "name": "port1",
      "display": "Controller 1 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2",
        "guitar",
        "jogcon",
        "negcon",
        "popn"
      ],
      "default": "dualshock2",
      "description": "What is plugged into port 1. 'dualshock2' is the standard pad, and what all but a handful of games expect. The instruments are for the games built around them: 'guitar' is the Guitar Hero controller (a strum bar, five frets, a whammy bar and a tilt sensor), 'jogcon' is Ridge Racer's force-feedback dial, 'negcon' is the twisting Namco pad, and 'popn' is Pop'n Music's nine buttons. They are offered on the two physical ports only.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port2",
      "display": "Controller 2 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2",
        "guitar",
        "jogcon",
        "negcon",
        "popn"
      ],
      "default": "none",
      "description": "What is plugged into port 2. 'dualshock2' is the standard pad, and what all but a handful of games expect. The instruments are for the games built around them: 'guitar' is the Guitar Hero controller (a strum bar, five frets, a whammy bar and a tilt sensor), 'jogcon' is Ridge Racer's force-feedback dial, 'negcon' is the twisting Namco pad, and 'popn' is Pop'n Music's nine buttons. They are offered on the two physical ports only.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port3",
      "display": "Controller 3 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2"
      ],
      "default": "none",
      "description": "What is plugged into port 1's multitap slot B, which needs multitap1 on. 'dualshock2' is the standard pad, and what all but a handful of games expect.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port4",
      "display": "Controller 4 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2"
      ],
      "default": "none",
      "description": "What is plugged into port 1's multitap slot C, which needs multitap1 on. 'dualshock2' is the standard pad, and what all but a handful of games expect.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port5",
      "display": "Controller 5 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2"
      ],
      "default": "none",
      "description": "What is plugged into port 1's multitap slot D, which needs multitap1 on. 'dualshock2' is the standard pad, and what all but a handful of games expect.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port6",
      "display": "Controller 6 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2"
      ],
      "default": "none",
      "description": "What is plugged into port 2's multitap slot B, which needs multitap2 on. 'dualshock2' is the standard pad, and what all but a handful of games expect.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port7",
      "display": "Controller 7 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2"
      ],
      "default": "none",
      "description": "What is plugged into port 2's multitap slot C, which needs multitap2 on. 'dualshock2' is the standard pad, and what all but a handful of games expect.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "port8",
      "display": "Controller 8 Type",
      "type": "enum",
      "options": [
        "none",
        "dualshock2"
      ],
      "default": "none",
      "description": "What is plugged into port 2's multitap slot D, which needs multitap2 on. 'dualshock2' is the standard pad, and what all but a handful of games expect.\n\nA slot's device is part of the machine: a game asks the SIO bus what is connected, so two projects that differ here are two different machines and do not share movies."
    },
    {
      "name": "multitap1",
      "display": "Multitap in Port 1",
      "type": "bool",
      "default": false,
      "description": "Whether a multitap is plugged into port 1, turning its one socket into four. A game can SEE the multitap whether or not anything is in it, and it is what makes controllers 3 to 5 and their memory cards reachable at all - so it is its own setting rather than something guessed from the controllers, which would make a card in a slot depend on a pad being in it."
    },
    {
      "name": "multitap2",
      "display": "Multitap in Port 2",
      "type": "bool",
      "default": false,
      "description": "Whether a multitap is plugged into port 2, turning its one socket into four. A game can SEE the multitap whether or not anything is in it, and it is what makes controllers 6 to 8 and their memory cards reachable at all - so it is its own setting rather than something guessed from the controllers, which would make a card in a slot depend on a pad being in it."
    },
    {
      "name": "memcard1",
      "display": "Memory Card 1",
      "type": "bool",
      "default": true,
      "description": "Whether there is a card in the console's slot 1. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard1.ps2."
    },
    {
      "name": "memcard2",
      "display": "Memory Card 2",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in the console's slot 2. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard2.ps2."
    },
    {
      "name": "memcard3",
      "display": "Memory Card 3",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in port 1's multitap slot B. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard3.ps2. Needs multitap1 on."
    },
    {
      "name": "memcard4",
      "display": "Memory Card 4",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in port 1's multitap slot C. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard4.ps2. Needs multitap1 on."
    },
    {
      "name": "memcard5",
      "display": "Memory Card 5",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in port 1's multitap slot D. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard5.ps2. Needs multitap1 on."
    },
    {
      "name": "memcard6",
      "display": "Memory Card 6",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in port 2's multitap slot B. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard6.ps2. Needs multitap2 on."
    },
    {
      "name": "memcard7",
      "display": "Memory Card 7",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in port 2's multitap slot C. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard7.ps2. Needs multitap2 on."
    },
    {
      "name": "memcard8",
      "display": "Memory Card 8",
      "type": "bool",
      "default": false,
      "description": "Whether there is a card in port 2's multitap slot D. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file: it arrives from, and leaves through, the save-data channel as memcard8.ps2. Needs multitap2 on."
    },
    {
      "name": "fast_boot",
      "display": "Skip the Console Boot",
      "type": "bool",
      "default": true,
      "description": "Boot the disc's own program directly instead of watching the console start up. The bios animation is about twenty seconds of emulated time and the machine is in a different state at the end of it, so this is part of what a movie was recorded on rather than a convenience: a run made with it does not replay without it."
    },
    {
      "name": "rtc_year",
      "display": "Clock: Year (00-99)",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 99,
      "description": "What year the console's clock says. A PS2 has a battery-backed clock and PCSX2 would otherwise read the computer's, which makes every run a different machine - some games seed their random numbers from it, and every save is stamped with it. The default is 2020: late enough that every PS2 game accepts it as today."
    },
    {
      "name": "rtc_month",
      "display": "Clock: Month",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 12,
      "description": "The month on the console's clock."
    },
    {
      "name": "rtc_day",
      "display": "Clock: Day",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 31,
      "description": "The day on the console's clock."
    },
    {
      "name": "rtc_hour",
      "display": "Clock: Hour",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 23,
      "description": "The hour on the console's clock."
    },
    {
      "name": "rtc_minute",
      "display": "Clock: Minute",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 59,
      "description": "The minute on the console's clock."
    },
    {
      "name": "rtc_second",
      "display": "Clock: Second",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 59,
      "description": "The second on the console's clock."
    },
    {
      "name": "verbose",
      "display": "Log the Machine",
      "type": "bool",
      "default": false,
      "description": "Let PCSX2 say what it is doing on the standard error stream: which bios and disc it found, what the IOP loaded, what it refused. It changes nothing about the machine - the clock this core runs on belongs to the emulated console, not to whoever is reading the log - and it is the first thing to turn on when a project will not start."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl",
        "opengl-hw"
      ],
      "default": "opengl-hw",
      "description": "Which renderer draws the picture. 'software' is PCSX2's own software rasteriser, about five times faster than the other two, and the default. 'opengl' is PCSX2's OpenGL renderer - the one upstream tests and most games are looked at through - drawing through a Mesa softpipe compiled into this core. Both of those run entirely inside the sandbox on the CPU, so both are deterministic and a movie made under one replays under the other. 'opengl-hw' is that same OpenGL renderer with its calls leaving the sandbox to your machine's GPU. It is far faster than the softpipe, and it is NOT deterministic: the picture comes from a driver that is outside the sandbox and the savestate, and differs between machines. A movie recorded on it records that a GPU drew. It is the default because it is what most runs want, and a run that needs a promise of replay can pick one of the other two at any point. It also needs a Chimera built with the bridge; without one this draws with the softpipe instead, which is slower but deterministic."
    },
    {
      "name": "deinterlace",
      "display": "Deinterlacing",
      "type": "enum",
      "options": [
        "auto",
        "adaptive",
        "adaptive-bff",
        "weave",
        "weave-bff",
        "blend",
        "bob",
        "off"
      ],
      "default": "auto",
      "description": "How the console's two fields become one picture, when they are two fields at all. A PS2 in an interlaced mode scans out HALF an image per frame - 224 lines of 448, the other half arriving next frame - so something has to say what a single field looks like as a whole frame. But plenty of games draw WHOLE frames instead, and putting one of those through a deinterlacer destroys half of it: the picture then carries one row of this frame and one row of the last, forever. 'auto' asks the machine which it is doing, leaves a whole frame alone, and reconstructs a field one with 'adaptive' - which is what PCSX2 itself does and what this should be left on. The rest force one answer. 'adaptive' compares this field with the three before it and decides, per pixel, whether to weave a line or invent one from the lines above and below: still pictures keep their full detail and moving ones do not comb. 'weave' puts each field's lines back in their proper places, which is the full picture the television showed; fast motion combs, as it does on the real machine. 'weave-bff' and 'adaptive-bff' are the same with the field order swapped, for a game that looks one line out of place. 'blend' is weave with the comb softened. 'bob' shows the current field alone, scaled up: never combs, and half the vertical detail. 'off' hands the field over stretched and puts nothing anywhere, which makes a still screen climb two scanlines and fall back every frame."
    },

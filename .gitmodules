[submodule "extern/pcsx2"]
	path = extern/pcsx2
	url = https://github.com/PCSX2/pcsx2.git
[submodule "extern/zlib"]
	path = extern/zlib
	url = https://github.com/madler/zlib.git
[submodule "extern/zstd"]
	path = extern/zstd
	url = https://github.com/facebook/zstd.git
[submodule "extern/lz4"]
	path = extern/lz4
	url = https://github.com/lz4/lz4.git
[submodule "extern/glslang"]
	path = extern/glslang
	url = https://github.com/KhronosGroup/glslang.git
[submodule "extern/openps2bios"]
	path = extern/openps2bios
	url = https://github.com/TamaribaEmu/OpenPS2BIOS.git
[submodule "extern/pcsx2_patches"]
	path = extern/pcsx2_patches
	url = https://github.com/PCSX2/pcsx2_patches.git
